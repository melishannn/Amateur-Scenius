rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { 
      return request.auth != null && request.auth.token.email_verified == true; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUserConfig(data) {
      return (!('chain' in data) || data.chain is string) &&
             (!('stars' in data) || data.stars is list) && 
             (!('revisits' in data) || data.revisits is map) &&
             data.keys().hasOnly(['chain', 'stars', 'revisits']);
    }

    function isValidPostConfig(data) {
      return data.keys().hasAll(['id', 'content']) &&
             data.id is number &&
             data.content is string &&
             (!('tags' in data) || data.tags is list) &&
             (!('isPublished' in data) || data.isPublished is bool) &&
             (!('isAmateur' in data) || data.isAmateur is bool) &&
             (!('isTeaching' in data) || data.isTeaching is bool) &&
             (!('platform' in data) || (data.platform is string && data.platform.size() <= 200)) &&
             (!('attrName' in data) || (data.attrName is string && data.attrName.size() <= 200)) &&
             (!('attrLink' in data) || (data.attrLink is string && data.attrLink.size() <= 500)) &&
             (!('attrHow' in data) || (data.attrHow is string && data.attrHow.size() <= 500)) &&
             (!('attrWhy' in data) || (data.attrWhy is string && data.attrWhy.size() <= 500)) &&
             (!('attrResonate' in data) || (data.attrResonate is string && data.attrResonate.size() <= 500)) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 100)) &&
             (!('aiPolished' in data) || data.aiPolished is bool) &&
             (!('rehberType' in data) || (data.rehberType is string && data.rehberType.size() <= 100)) &&
             (!('guideType' in data) || (data.guideType is string && data.guideType.size() <= 100)) &&
             (!('sourceTag' in data) || (data.sourceTag is string && data.sourceTag.size() <= 100)) &&
             (!('media' in data) || (data.media is list));
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserConfig(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserConfig(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      
      match /posts/{postId} {
        allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(postId);
        allow list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(postId) && isValidPostConfig(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(postId) && isValidPostConfig(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(postId);
      }
    }
  }
}
