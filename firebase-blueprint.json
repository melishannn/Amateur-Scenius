{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile state containing non-post fields",
      "type": "object",
      "properties": {
        "chain": { "type": "string" },
        "stars": {
          "type": "array",
          "items": { "type": "number" }
        },
        "revisits": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "Post": {
      "title": "Post",
      "description": "A single post entity",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "isPublished": { "type": "boolean" },
        "isAmateur": { "type": "boolean" },
        "isTeaching": { "type": "boolean" },
        "platform": { "type": "string" },
        "attrName": { "type": "string" },
        "attrLink": { "type": "string" },
        "attrHow": { "type": "string" },
        "attrWhy": { "type": "string" },
        "attrResonate": { "type": "string" },
        "date": { "type": "string" },
        "aiPolished": { "type": "boolean" },
        "rehberType": { "type": "string" },
        "guideType": { "type": "string" },
        "sourceTag": { "type": "string" },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["image", "audio", "text"] },
              "url": { "type": "string" },
              "name": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "content", "tags", "isPublished", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "The user document containing general app state"
    },
    "/users/{userId}/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "The posts created by the user"
    }
  }
}
